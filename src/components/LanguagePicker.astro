---
import { languages } from '../i18n/ui';
const { currentLang } = Astro.props;

// Swap only the leading /<lang>/ segment so switching language keeps the
// visitor on the same page (e.g. the weather-dna quiz or a result permalink)
// instead of always bouncing them to that language's homepage.
const restOfPath = Astro.url.pathname.replace(/^\/[a-z]{2}(\/|$)/, '/');
function localizedHref(lang: string) {
  return `/${lang}${restOfPath}`;
}
---
<ul class="lang-dropdown-list">
  {Object.entries(languages).map(([lang, label]) => (
    <li>
      <a href={localizedHref(lang)} class:list={['lang-row', { active: currentLang === lang }]}>
        <img src={`/icons/flags/${lang}.svg`} alt="" class="lang-flag" />
        <span>{label}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .lang-dropdown-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lang-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 14px;
    text-decoration: none;
    color: black;
    font-weight: 700;
    font-size: 0.95rem;
    transition: background 0.15s ease;
  }
  .lang-row:hover {
    background: var(--wd-lime, #D0FF00);
  }
  .lang-row.active {
    background: black;
    color: white;
    font-weight: 900;
  }
  .lang-flag {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
</style>
