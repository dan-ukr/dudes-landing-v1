---
// src/pages/[lang]/weather-dna/r/[id].astro
// No `export const prerender = true` here — this must stay server-rendered
// (site default per astro.config.mjs output:"server") since it reads one
// row from D1 per request.
import Layout from '../../../../layouts/layout.astro';
import { ui, languages, PRODUCTS, WEATHERDUDE_GOOGLE_PLAY_URL } from '../../../../i18n/ui';
import { getArchetype } from '../../../../lib/weather-dna/archetypes';

const { lang, id } = Astro.params;
const t = ui[(lang as keyof typeof ui) in languages ? (lang as keyof typeof ui) : 'en'];

const { DB } = Astro.locals.runtime.env;
const row = await DB.prepare(
  `SELECT archetype_code, thermal_score, adaptability_score, rain_score, wind_score, top_cities_json, outfit_json
   FROM weather_dna_results WHERE id = ?`
)
  .bind(id)
  .first<{
    archetype_code: string;
    thermal_score: number;
    adaptability_score: number;
    rain_score: number;
    wind_score: number;
    top_cities_json: string;
    outfit_json: string;
  }>();

if (!row) {
  Astro.response.status = 404;
}

// Live leaderboard: which archetypes are landing most often, re-queried on
// every page view so it stays current as new quiz results come in.
const leaderboardRows = row
  ? await DB.prepare(
      `SELECT archetype_code, COUNT(*) as cnt FROM weather_dna_results GROUP BY archetype_code ORDER BY cnt DESC LIMIT 5`
    ).all<{ archetype_code: string; cnt: number }>()
  : null;
// Slavic-style 3-way plural (1 / 2-4 / 5+, with the usual 11-14 exception)
// for ua/pl/be; everyone else just gets singular vs plural.
const SLAVIC_PLURAL_LANGS = new Set(['ua', 'pl', 'be']);
function pluralizePeople(count: number): string {
  const mod10 = count % 10;
  const mod100 = count % 100;
  if (SLAVIC_PLURAL_LANGS.has(lang ?? 'en')) {
    if (mod10 === 1 && mod100 !== 11) return t['weatherdna.leaderboard.person' as keyof typeof t];
    if (mod10 >= 2 && mod10 <= 4 && !(mod100 >= 12 && mod100 <= 14)) {
      return t['weatherdna.leaderboard.peopleFew' as keyof typeof t];
    }
    return t['weatherdna.leaderboard.peopleMany' as keyof typeof t];
  }
  return count === 1
    ? t['weatherdna.leaderboard.person' as keyof typeof t]
    : t['weatherdna.leaderboard.peopleMany' as keyof typeof t];
}

const leaderboard = (leaderboardRows?.results ?? []).map((r) => ({
  archetype: getArchetype(r.archetype_code),
  count: r.cnt,
}));

const archetype = row ? getArchetype(row.archetype_code) : null;
const topCities: Array<{ name: string; country: string; tempC: number; isLive: boolean }> = row
  ? JSON.parse(row.top_cities_json)
  : [];
const outfit: {
  topLayerKey: string;
  bottomKey: string;
  footwearKey: string;
  accessoryKey: string;
  topLayerIcon?: string;
  bottomIcon?: string;
  footwearIcon?: string;
} | null = row ? JSON.parse(row.outfit_json) : null;

const toPips = (score: number) => Math.min(5, Math.max(1, Math.round(score / 20)));
const pipCounts = row
  ? {
      thermal: toPips(row.thermal_score),
      adaptability: toPips(row.adaptability_score),
      rain: toPips(row.rain_score),
      wind: toPips(row.wind_score),
    }
  : { thermal: 0, adaptability: 0, rain: 0, wind: 0 };
const thermalParts = row
  ? t['weatherdna.result.hero.trait.thermal'].split('↔').map((s) => s.trim())
  : ['', ''];
const PIPS = [1, 2, 3, 4, 5];

// Per-axis pip glyphs (stroke-drawn, colored via currentColor so the same
// path works on both the white/unfilled and black/filled pip backgrounds).
const ICON_PATHS: Record<string, string> = {
  snowflake: '<line x1="12" y1="4" x2="12" y2="20"/><line x1="5" y1="8" x2="19" y2="16"/><line x1="19" y1="8" x2="5" y2="16"/>',
  shield: '<path d="M12 3l7 3v5c0 5-3 8-7 9-4-1-7-4-7-9V6z"/>',
  flame: '<path d="M12 3c-1 4-6 6-6 11a6 6 0 0 0 12 0c0-2-1-4-2-5 0 2-1 3-2 2 1-3 0-6-2-8z"/>',
  wind: '<path d="M3 8c3-2 5 1 8 0M3 12c4-2 7 1 11 0M3 16c3-2 5 1 8 0"/>',
  raindrop: '<path d="M12 3c-3 5-6 9-6 12a6 6 0 0 0 12 0c0-3-3-7-6-12z"/>',
};
// Thermal's 5 pips step through distinct glyphs cold->hot; rain/wind reuse
// one glyph per pip; adaptability stays plain squares (unchanged).
const THERMAL_ICON_SEQUENCE = ['snowflake', 'snowflake', 'shield', 'flame', 'flame'];
---

<Layout lang={lang} title={row && archetype ? t[archetype.nameKey as keyof typeof t] : t['weatherdna.result.notFound.title']}>
  <main class="wdna-result">
    {!row || !archetype ? (
      <section class="wdna-not-found">
        <h1>{t['weatherdna.result.notFound.title']}</h1>
        <a href={`/${lang}/weather-dna/`}>{t['weatherdna.result.notFound.cta']}</a>
      </section>
    ) : (
      <>
        <section class="wdna-hero-wrap">
          <div id="wdna-hero-card" class="wdna-hero-card" data-bg="lime">
            <div class="wdna-hero-top">
              <img
                src={archetype.image}
                alt=""
                class="wdna-hero-image"
                onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';"
              />
              <div class="wdna-hero-image-fallback" style="display:none;">{t[archetype.nameKey as keyof typeof t]}</div>
            </div>

            <div class="wdna-hero-middle" id="wdna-hero-middle">
              <h1 class="wdna-hero-name">{t[archetype.nameKey as keyof typeof t]}</h1>
              <p class="wdna-archetype-description" id="wdna-archetype-description">{t[archetype.descriptionKey as keyof typeof t]}</p>
            </div>

            <div class="wdna-hero-bottom">
              <div class="wdna-traits">
                <div class="wdna-trait-group">
                  <span class="wdna-trait-name">{t['weatherdna.result.hero.trait.thermal.name' as keyof typeof t]}</span>
                  <div class="wdna-trait-row">
                    <span class="wdna-trait-label">{thermalParts[0]}</span>
                    <div class="wdna-pips">
                      {PIPS.map((i) => (
                        <span class={`wdna-pip-icon ${i <= pipCounts.thermal ? 'is-filled' : ''}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICON_PATHS[THERMAL_ICON_SEQUENCE[i - 1]]} />
                        </span>
                      ))}
                    </div>
                    <span class="wdna-trait-label">{thermalParts[1]}</span>
                  </div>
                </div>
                <div class="wdna-trait-group">
                  <span class="wdna-trait-name">{t['weatherdna.result.hero.trait.adaptability.name' as keyof typeof t]}</span>
                  <div class="wdna-trait-row">
                    <span class="wdna-trait-label">{t['weatherdna.result.hero.trait.adaptability.low' as keyof typeof t]}</span>
                    <div class="wdna-pips">
                      {PIPS.map((i) => <span class={`wdna-pip ${i <= pipCounts.adaptability ? 'is-filled' : ''}`}></span>)}
                    </div>
                    <span class="wdna-trait-label">{t['weatherdna.result.hero.trait.adaptability.high' as keyof typeof t]}</span>
                  </div>
                </div>
                <div class="wdna-trait-group">
                  <span class="wdna-trait-name">{t['weatherdna.result.hero.trait.rain.name' as keyof typeof t]}</span>
                  <div class="wdna-trait-row">
                    <span class="wdna-trait-label">{t['weatherdna.result.hero.trait.rain.low' as keyof typeof t]}</span>
                    <div class="wdna-pips">
                      {PIPS.map((i) => (
                        <span class={`wdna-pip-icon ${i <= pipCounts.rain ? 'is-filled' : ''}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICON_PATHS.raindrop} />
                        </span>
                      ))}
                    </div>
                    <span class="wdna-trait-label">{t['weatherdna.result.hero.trait.rain.high' as keyof typeof t]}</span>
                  </div>
                </div>
                <div class="wdna-trait-group">
                  <span class="wdna-trait-name">{t['weatherdna.result.hero.trait.wind.name' as keyof typeof t]}</span>
                  <div class="wdna-trait-row">
                    <span class="wdna-trait-label">{t['weatherdna.result.hero.trait.wind.low' as keyof typeof t]}</span>
                    <div class="wdna-pips">
                      {PIPS.map((i) => (
                        <span class={`wdna-pip-icon ${i <= pipCounts.wind ? 'is-filled' : ''}`}>
                          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" set:html={ICON_PATHS.wind} />
                        </span>
                      ))}
                    </div>
                    <span class="wdna-trait-label">{t['weatherdna.result.hero.trait.wind.high' as keyof typeof t]}</span>
                  </div>
                </div>
              </div>

              <div class="wdna-hero-brand">
                <img src={PRODUCTS.weatherdude.logo} alt="WeatherDude" class="wdna-hero-logo" />
                <span class="wdna-hero-brandname">WeatherDude</span>
              </div>
            </div>
          </div>

          <div class="wdna-hero-controls">
            <div class="wdna-bg-swatches">
              <button type="button" data-bg="lime" style="background:var(--wd-lime)"></button>
              <button type="button" data-bg="pink" style="background:var(--wd-pink)"></button>
              <button type="button" data-bg="yellow" style="background:var(--wd-yellow)"></button>
              <button type="button" data-bg="violet" style="background:var(--md-purple)"></button>
            </div>
            <button type="button" id="wdna-download-btn">{t['weatherdna.result.hero.download']}</button>
            <button type="button" id="wdna-share-btn">{t['weatherdna.result.hero.share']}</button>
            <a href={`/${lang}/weather-dna/`}>{t['weatherdna.result.hero.retake']}</a>
          </div>
        </section>

        <section class="wdna-cities">
          <h2>{t['weatherdna.result.cities.title']}</h2>
          <ul>
            {topCities.map((c) => (
              <li>
                {c.name}, {c.country} — {Math.round(c.tempC)}°C
                {!c.isLive && <span class="wdna-typical-note"> ({t['weatherdna.result.cities.typical']})</span>}
              </li>
            ))}
          </ul>
          {topCities[0] && (
            <p>
              {t['weatherdna.result.cities.explanation']
                .replace('{city}', topCities[0].name)
                .replace('{temp}', String(Math.round(topCities[0].tempC)))
                .replace('{flavor}', t[archetype.flavorKey as keyof typeof t])}
            </p>
          )}
        </section>

        {outfit && (
          <section class="wdna-outfit">
            <h2>{t['weatherdna.result.outfit.title']}</h2>
            {(outfit.topLayerIcon || outfit.bottomIcon || outfit.footwearIcon) && (
              <div class="wdna-outfit-icons">
                {outfit.topLayerIcon && <img src={outfit.topLayerIcon} alt="" />}
                {outfit.bottomIcon && <img src={outfit.bottomIcon} alt="" />}
                {outfit.footwearIcon && <img src={outfit.footwearIcon} alt="" />}
              </div>
            )}
            <p>
              {t['weatherdna.result.outfit.line']
                .replace('{top}', t[outfit.topLayerKey as keyof typeof t])
                .replace('{bottom}', t[outfit.bottomKey as keyof typeof t])
                .replace('{footwear}', t[outfit.footwearKey as keyof typeof t])
                .replace('{accessory}', t[outfit.accessoryKey as keyof typeof t])}
            </p>
          </section>
        )}

        {leaderboard.length > 0 && (
          <section class="wdna-leaderboard">
            <h2>{t['weatherdna.leaderboard.title' as keyof typeof t]}</h2>
            <ul>
              {leaderboard.map((entry) => (
                <li>
                  <img
                    src={entry.archetype.image}
                    alt=""
                    class="wdna-leaderboard-icon"
                    onerror="this.style.visibility='hidden';"
                  />
                  <span class="wdna-leaderboard-name">{t[entry.archetype.nameKey as keyof typeof t]}</span>
                  <span class="wdna-leaderboard-count">
                    {entry.count} {pluralizePeople(entry.count)}
                  </span>
                </li>
              ))}
            </ul>
          </section>
        )}

        <section class="wdna-cta">
          <img src={PRODUCTS.weatherdude.logo} alt="WeatherDude" />
          <span class="wdna-cta-brandname">WeatherDude</span>
          <h2>{t['weatherdna.result.cta.title']}</h2>
          <p>{t['weatherdna.result.cta.body']}</p>
          <div class="wdna-cta-buttons">
            <a href={WEATHERDUDE_GOOGLE_PLAY_URL} target="_blank" rel="noopener noreferrer" class="wdna-cta-btn">
              {t['weatherdna.result.cta.button']}
            </a>
            <a href="#" class="wdna-cta-btn wdna-cta-btn-ios" aria-disabled="true" onclick="return false;">
              {t['weatherdna.result.cta.buttonIos' as keyof typeof t]}
            </a>
          </div>
        </section>
      </>
    )}
  </main>

  <style>
    .wdna-result { max-width: 700px; margin: 0 auto; padding: 120px 20px 60px; }
    .wdna-hero-card {
      position: relative; border: 6px solid black; border-radius: 32px;
      box-shadow: 14px 14px 0px black; text-align: center; background: var(--wd-lime);
      overflow: hidden; aspect-ratio: 9 / 16; max-width: 380px; width: 100%; margin: 0 auto;
      display: flex; flex-direction: column; padding: 18px 18px 12px;
    }
    .wdna-hero-card[data-bg='pink'] { background: var(--wd-pink); }
    .wdna-hero-card[data-bg='yellow'] { background: var(--wd-yellow); }
    .wdna-hero-card[data-bg='violet'] { background: var(--md-purple); }
    .wdna-hero-top { flex: 36 1 0; min-height: 0; display: flex; align-items: center; justify-content: center; }
    /* object-fit: contain -- the character art must never be cropped, even
       if that means letterboxing within this section. */
    .wdna-hero-image { max-width: 100%; max-height: 100%; display: block; border-radius: 20px; object-fit: contain; }
    .wdna-hero-image-fallback {
      width: 100%; height: 100%; align-items: center; justify-content: center;
      border: 4px dashed black; border-radius: 20px; font-weight: 900; font-size: 1.2rem;
    }
    .wdna-hero-middle { flex: 32 1 0; min-height: 0; display: flex; flex-direction: column; justify-content: center; overflow: hidden; }
    /* space-between (not center) so the brand block pins to the true bottom
       edge of the card, with the trait rows sitting above it. */
    .wdna-hero-bottom { flex: 32 1 0; min-height: 0; display: flex; flex-direction: column; justify-content: space-between; gap: 6px; }
    .wdna-hero-brand { display: flex; align-items: center; justify-content: center; gap: 8px; margin-top: 6px; }
    .wdna-hero-logo { height: 30px; }
    .wdna-hero-brandname { font-style: italic; font-weight: 900; font-size: 1.05rem; }
    .wdna-hero-controls { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 20px; }
    .wdna-bg-swatches button { width: 30px; height: 30px; border-radius: 50%; border: 3px solid black; margin-right: 6px; }
    .wdna-cta { text-align: center; margin-top: 60px; padding: 30px; border: 6px solid black; border-radius: 30px; }
    .wdna-cta-btn { display: inline-block; margin-top: 16px; padding: 14px 28px; border-radius: 99px; border: 4px solid black; background: var(--wd-lime); font-weight: 900; text-decoration: none; color: black; }
    .wdna-cta-buttons { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; }
    .wdna-cta-btn-ios { background: white; cursor: default; }

    .wdna-result h1, .wdna-result h2 {
      font-weight: 900; font-style: italic; text-transform: uppercase; line-height: 1.1; margin: 0 0 12px;
    }
    .wdna-result h1 { font-size: clamp(1.6rem, 5vw, 2.4rem); }
    .wdna-result h2 { font-size: clamp(1.3rem, 4vw, 1.8rem); text-align: center; }
    .wdna-result p { font-size: 1.05rem; font-weight: 600; line-height: 1.4; }
    .wdna-hero-card .wdna-hero-name { font-size: clamp(1rem, 6vw, 1.35rem); margin: 0 0 6px; }
    .wdna-not-found { text-align: center; padding: 120px 20px; }
    .wdna-not-found a { display: inline-block; margin-top: 16px; padding: 14px 28px; border-radius: 99px; border: 4px solid black; background: var(--wd-lime); font-weight: 900; text-decoration: none; color: black; }
    .wdna-hero-controls button, .wdna-hero-controls a {
      padding: 12px 22px; border-radius: 99px; border: 4px solid black; font-weight: 900; text-transform: uppercase;
      font-size: 0.85rem; cursor: pointer; text-decoration: none; color: black; background: white;
    }
    #wdna-download-btn { background: var(--wd-lime); }
    #wdna-share-btn { background: var(--wd-pink); }
    .wdna-cities, .wdna-outfit { margin-top: 50px; text-align: center; }
    .wdna-cities ul { list-style: none; padding: 0; margin: 20px 0; display: flex; flex-direction: column; gap: 10px; align-items: center; }
    .wdna-cities li { padding: 10px 20px; border: 3px solid black; border-radius: 14px; font-weight: 700; background: var(--wd-lime); }
    .wdna-cities li:nth-child(2) { background: var(--wd-pink); }
    .wdna-cities li:nth-child(3) { background: var(--wd-yellow); }
    .wdna-typical-note { font-size: 0.8rem; opacity: 0.6; font-weight: 700; }
    .wdna-cta h2 { font-size: clamp(1.4rem, 4vw, 2rem); }

    :global(.site-footer) { display: none; }

    /* No line-clamp here on purpose -- the description must always show in
       full, in every language, never truncated with an ellipsis. A small
       client-side script (weather-dna-card.ts) shrinks this element's font
       size just enough to fit its allotted space if a translation runs
       long; it never cuts text. */
    .wdna-result p.wdna-archetype-description {
      text-align: center; text-transform: none; font-weight: 400; font-size: 0.72rem;
      line-height: 1.32; margin: 0 auto; padding: 0 4px;
    }

    .wdna-traits { display: flex; flex-direction: column; gap: 6px; }
    .wdna-trait-group { display: flex; flex-direction: column; align-items: center; gap: 1px; }
    .wdna-trait-name {
      font-size: 0.52rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.03em; opacity: 0.55;
    }
    .wdna-trait-row { display: flex; align-items: center; justify-content: center; gap: 6px; }
    .wdna-trait-label {
      font-size: 0.65rem; font-weight: 800; text-transform: uppercase; line-height: 1.15;
      width: 50px; flex-shrink: 0;
    }
    .wdna-trait-row .wdna-trait-label:first-child { text-align: right; }
    .wdna-trait-row .wdna-trait-label:last-child { text-align: left; }
    .wdna-pips { display: flex; gap: 3px; flex-shrink: 0; }
    /* Adaptability keeps plain squares. */
    .wdna-pip { width: 13px; height: 13px; border: 2px solid black; border-radius: 3px; background: white; flex-shrink: 0; }
    .wdna-pip.is-filled { background: black; }
    /* Thermal/rain/wind use circular icon pips instead -- white bg + black
       glyph when unfilled, black bg + white glyph when filled. */
    .wdna-pip-icon {
      width: 17px; height: 17px; border-radius: 50%; border: 2px solid black;
      background: white; color: black; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
    }
    .wdna-pip-icon svg { width: 11px; height: 11px; }
    .wdna-pip-icon.is-filled { background: black; color: white; }

    .wdna-outfit-icons { display: flex; gap: 10px; justify-content: center; margin: 16px 0; flex-wrap: wrap; }
    .wdna-outfit-icons img {
      width: 60px; height: 60px; background: white; border: 3px solid black; border-radius: 12px; object-fit: contain;
    }

    .wdna-cta-brandname { display: block; font-style: italic; font-weight: 900; font-size: 1.3rem; margin-top: 6px; }

    .wdna-leaderboard { margin-top: 50px; text-align: center; }
    .wdna-leaderboard ul {
      list-style: none; padding: 0; margin: 20px auto 0; max-width: 420px;
      display: flex; flex-direction: column; gap: 10px;
    }
    .wdna-leaderboard li {
      display: flex; align-items: center; gap: 12px; padding: 10px 16px;
      border: 3px solid black; border-radius: 16px; background: white;
      box-shadow: 4px 4px 0px black; text-align: left;
    }
    .wdna-leaderboard-icon {
      width: 36px; height: 36px; border-radius: 50%; object-fit: cover;
      border: 2px solid black; flex-shrink: 0; background: var(--wd-lime);
    }
    .wdna-leaderboard-name { font-weight: 900; flex: 1; }
    .wdna-leaderboard-count { font-size: 0.85rem; font-weight: 700; opacity: 0.7; white-space: nowrap; }
  </style>

  <script src="../../../../scripts/weather-dna-card.ts"></script>
</Layout>
