---
// src/pages/[lang]/weather-dna/index.astro
export const prerender = true;
import Layout from '../../../layouts/layout.astro';
import { ui, languages } from '../../../i18n/ui';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = ui[lang as keyof typeof ui];
---

<Layout lang={lang} title={t['weatherdna.meta.title']}>
  <!-- layout.astro only exposes the default slot, not a named "head" slot,
       so the meta description can't be injected from here without modifying
       layout.astro. Skipping it for v1, matching [lang]/index.astro which
       also relies on `title` alone with no per-page description override. -->

  <main class="wdna-quiz">
    <section class="wdna-step" data-step="intro" data-active="true">
      <h1>{t['weatherdna.intro.title']}</h1>
      <p>{t['weatherdna.intro.subtitle']}</p>
      <button type="button" data-action="start">{t['weatherdna.intro.start']}</button>
    </section>

    <section class="wdna-step" data-step="city">
      <h2>{t['weatherdna.step.city.title']}</h2>
      <input
        type="text"
        id="wdna-home-city-input"
        placeholder={t['weatherdna.step.city.placeholder']}
        autocomplete="off"
      />
      <ul id="wdna-home-city-results" class="wdna-city-suggestions"></ul>
      <button type="button" data-action="next-from-city" disabled>{t['weatherdna.step.next']}</button>
    </section>
    <!-- Note: the Next button also enables on manual typing (see weather-dna-quiz.ts),
         not only on an autocomplete pick — home city is display-only, never used in
         scoring, so a geocoder outage must never be able to block the quiz. -->

    <section class="wdna-step" data-step="pastClimates">
      <h2>{t['weatherdna.step.pastClimates.title']}</h2>
      <p>{t['weatherdna.step.pastClimates.subtitle']}</p>
      <input type="text" id="wdna-past-city-input" placeholder={t['weatherdna.step.city.placeholder']} autocomplete="off" />
      <ul id="wdna-past-city-results" class="wdna-city-suggestions"></ul>
      <ul id="wdna-past-city-picked"></ul>
      <button type="button" data-action="add-past-city">{t['weatherdna.step.pastClimates.add']}</button>
      <button type="button" data-action="next-from-pastClimates">{t['weatherdna.step.next']}</button>
    </section>

    <section class="wdna-step" data-step="swipe">
      <p>{t['weatherdna.step.swipe.intro']}</p>
      <div id="wdna-swipe-stack" class="wdna-swipe-stack">
        <div class="wdna-swipe-card" data-dimension="rain" data-order="0">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.rain1']}
        </div>
        <div class="wdna-swipe-card" data-dimension="rain" data-order="1">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.rain2']}
        </div>
        <div class="wdna-swipe-card" data-dimension="rain" data-order="2">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.rain3']}
        </div>
        <div class="wdna-swipe-card" data-dimension="layering" data-order="3">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.layering1' as keyof typeof t]}
        </div>
        <div class="wdna-swipe-card" data-dimension="snow" data-order="4">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.snow1']}
        </div>
        <div class="wdna-swipe-card" data-dimension="snow" data-order="5">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.snow2']}
        </div>
        <div class="wdna-swipe-card" data-dimension="snow" data-order="6">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.snow3']}
        </div>
        <div class="wdna-swipe-card" data-dimension="layering" data-order="7">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.layering2' as keyof typeof t]}
        </div>
        <div class="wdna-swipe-card" data-dimension="wind" data-order="8">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.wind1']}
        </div>
        <div class="wdna-swipe-card" data-dimension="wind" data-order="9">
          <span class="wdna-hint wdna-hint-agree">{t['weatherdna.swipe.hintAgree' as keyof typeof t]}</span>
          <span class="wdna-hint wdna-hint-disagree">{t['weatherdna.swipe.hintDisagree' as keyof typeof t]}</span>
          {t['weatherdna.swipe.wind2']}
        </div>
      </div>
    </section>

    <section class="wdna-step" data-step="sliders">
      <h2>{t['weatherdna.step.sliders.title']}</h2>

      <label>{t['weatherdna.step.sliders.summer.label']}</label>
      <div class="wdna-slider-row">
        <span>{t['weatherdna.step.sliders.summer.low']}</span>
        <input type="range" id="wdna-slider-summer" min="1" max="5" value="3" list="wdna-summer-ticks" />
        <datalist id="wdna-summer-ticks">
          <option value="1"></option>
          <option value="2"></option>
          <option value="3"></option>
          <option value="4"></option>
          <option value="5"></option>
        </datalist>
        <span>{t['weatherdna.step.sliders.summer.high']}</span>
      </div>

      <label>{t['weatherdna.step.sliders.winter.label']}</label>
      <div class="wdna-slider-row">
        <span>{t['weatherdna.step.sliders.winter.low']}</span>
        <input type="range" id="wdna-slider-winter" min="1" max="5" value="3" list="wdna-winter-ticks" />
        <datalist id="wdna-winter-ticks">
          <option value="1"></option>
          <option value="2"></option>
          <option value="3"></option>
          <option value="4"></option>
          <option value="5"></option>
        </datalist>
        <span>{t['weatherdna.step.sliders.winter.high']}</span>
      </div>

      <label>{t['weatherdna.step.sliders.fit.label']}</label>
      <div class="wdna-slider-row">
        <span>{t['weatherdna.step.sliders.fit.low']}</span>
        <input type="range" id="wdna-slider-fit" min="1" max="5" value="3" list="wdna-fit-ticks" />
        <datalist id="wdna-fit-ticks">
          <option value="1"></option>
          <option value="2"></option>
          <option value="3"></option>
          <option value="4"></option>
          <option value="5"></option>
        </datalist>
        <span>{t['weatherdna.step.sliders.fit.high']}</span>
      </div>

      <button type="button" data-action="submit-quiz">{t['weatherdna.step.sliders.submit']}</button>
      <p id="wdna-submit-error" class="wdna-submit-error" data-error={t['weatherdna.step.sliders.submitError']} style="display:none;"></p>
    </section>
  </main>

  <style>
    :global(.site-footer) { display: none; }

    .wdna-quiz { max-width: 600px; margin: 0 auto; padding: 120px 20px 60px; }
    .wdna-step[data-step='intro'] { text-align: center; }
    .wdna-step { display: none; }
    .wdna-step[data-active='true'] { display: block; }
    .wdna-city-suggestions {
      list-style: none; padding: 10px; margin: 8px 0; background: white;
      border: 4px solid black; border-radius: 16px; box-shadow: 5px 5px 0px black;
    }
    .wdna-city-suggestions li { padding: 10px 14px; border: 3px solid black; border-radius: 14px; margin-bottom: 6px; cursor: pointer; }
    .wdna-city-suggestions li:last-child { margin-bottom: 0; }
    .wdna-swipe-stack { position: relative; height: min(480px, 70vh); max-width: 340px; margin: 0 auto; }
    .wdna-swipe-card {
      position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
      text-align: center; padding: 30px; border: 6px solid black; border-radius: 30px;
      background: var(--wd-white); font-weight: 900; font-size: 1.3rem; cursor: grab;
      box-shadow: 10px 10px 0px black; user-select: none; touch-action: none;
      transition: background-color 0.1s ease; opacity: 1;
    }
    .wdna-swipe-card[data-done='true'] { display: none; }
    /* Subtle rest-state per-topic tint so the 10-card deck doesn't read as
       identical white cards. Overridden by the inline drag-color-feedback
       style (set/cleared in weather-dna-quiz.ts) while dragging. */
    .wdna-swipe-card[data-dimension='rain'] { background: #eaf4ff; }
    .wdna-swipe-card[data-dimension='snow'] { background: #f4f2fb; }
    .wdna-swipe-card[data-dimension='wind'] { background: #f2f2f2; }
    .wdna-swipe-card[data-dimension='layering'] { background: #faf3e6; }
    .wdna-hint {
      position: absolute; top: 20px; padding: 6px 14px; border-radius: 10px;
      font-size: 1.1rem; font-weight: 900; text-transform: uppercase; opacity: 0; pointer-events: none;
    }
    .wdna-hint-agree { right: 20px; color: #16a34a; border: 4px solid #16a34a; transform: rotate(-12deg); }
    .wdna-hint-disagree { left: 20px; color: #dc2626; border: 4px solid #dc2626; transform: rotate(12deg); }
    .wdna-slider-row { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
    /* The slider must never shrink to make room for label text — labels wrap
       (even one word per line) before the track is allowed to compress. */
    .wdna-slider-row input[type='range'] { flex: 1 1 auto; min-width: 100px; }
    /* Wrap only at word boundaries -- a word may sit alone on its own line,
       but it is never split mid-word. If a single word still doesn't fit,
       shrink the font for that language rather than break the word. */
    .wdna-slider-row span {
      font-size: 0.72rem; font-weight: 900; text-transform: uppercase; opacity: 0.7;
      white-space: normal; word-break: normal; overflow-wrap: normal; hyphens: none;
      text-align: center; flex: 0 1 68px;
    }

    @media (max-width: 480px) {
      .wdna-quiz { padding-top: 80px; }
      .wdna-slider-row span { font-size: 0.58rem; flex-basis: 52px; }
    }

    .wdna-quiz h1 {
      font-size: clamp(1.8rem, 5vw, 2.6rem);
      font-weight: 900;
      font-style: italic;
      text-transform: uppercase;
      line-height: 1.05;
      margin: 0 0 12px;
    }
    .wdna-quiz h2 {
      font-size: clamp(1.4rem, 4vw, 1.9rem);
      font-weight: 900;
      font-style: italic;
      text-transform: uppercase;
      line-height: 1.1;
      margin: 0 0 12px;
    }
    .wdna-quiz h3 {
      font-size: 0.85rem;
      font-weight: 900;
      text-transform: uppercase;
      margin: 20px 0 8px;
    }
    .wdna-quiz p { font-size: 1.05rem; font-weight: 600; opacity: 0.85; margin: 0 0 24px; }
    .wdna-quiz label { display: block; font-weight: 900; text-transform: uppercase; font-size: 0.85rem; margin: 20px 0 8px; }
    .wdna-quiz input[type='text'] {
      width: 100%; padding: 14px 18px; border: 4px solid black; border-radius: 16px;
      font-weight: 700; font-size: 1rem; background: white; box-sizing: border-box;
    }
    .wdna-quiz input[type='text']:focus { outline: none; box-shadow: 4px 4px 0px black; }
    .wdna-quiz button {
      display: inline-block; margin-top: 20px; padding: 14px 28px; border-radius: 99px;
      border: 4px solid black; background: var(--wd-lime); font-weight: 900; text-transform: uppercase;
      font-size: 0.95rem; cursor: pointer; box-shadow: 5px 5px 0px black; transition: transform 0.15s ease, box-shadow 0.15s ease;
    }
    .wdna-quiz button:hover:not(:disabled) { transform: translate(-2px, -2px); box-shadow: 7px 7px 0px black; }
    .wdna-quiz button:disabled { opacity: 0.4; cursor: not-allowed; box-shadow: none; }
    .wdna-submit-error {
      margin-top: 16px; padding: 14px 20px; border-radius: 20px;
      background: #e5484d; color: white; font-weight: 900; text-transform: uppercase;
    }
    .wdna-quiz button[data-action='add-past-city'] { background: white; margin-right: 12px; }
    .wdna-quiz #wdna-past-city-picked { list-style: none; padding: 0; margin: 12px 0; display: flex; flex-wrap: wrap; gap: 8px; }
    .wdna-quiz #wdna-past-city-picked li { padding: 8px 14px; border: 3px solid black; border-radius: 99px; font-weight: 700; font-size: 0.9rem; background: var(--wd-yellow); }
  </style>

  <script src="../../../scripts/weather-dna-quiz.ts"></script>
</Layout>
